<?xml version="1.0"?>
<ruleset name="WP-Polls">
	<description>WordPress Coding Standards for WP-Polls.</description>

	<file>.</file>

	<!-- Scanning these makes the CI runner run out of memory. -->
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="ps"/>

	<rule ref="WordPress">
		<!-- The plugin owns three tables. There is no core API to use and
		     nothing to cache, so these two are noise here. -->
		<exclude name="WordPress.DB.DirectDatabaseQuery.DirectQuery"/>
		<exclude name="WordPress.DB.DirectDatabaseQuery.NoCaching"/>
		<!-- Table identifiers cannot be bound, and %i needs WP 6.2. -->
		<exclude name="WordPress.DB.PreparedSQL.InterpolatedNotPrepared"/>
	</rule>

	<!-- The public voting endpoint is nonce-checked by check_ajax_referer()
	     inside the handler, which the sniff cannot see.

	     Polls_Display only ever reads request data to decide which poll to
	     render (?pollresult=N, the posted poll_id) and writes nothing, so there
	     is nothing for a nonce to protect. Every state change goes through
	     Polls_Vote, which does check one. -->
	<rule ref="WordPress.Security.NonceVerification">
		<exclude-pattern>/includes/class-polls-vote.php</exclude-pattern>
		<exclude-pattern>/includes/class-polls-display.php</exclude-pattern>
	</rule>

	<!-- Polls_Vote::polls_acquire_lock() takes an flock() advisory lock so two
	     concurrent votes cannot both read the same tally. WP_Filesystem has no
	     locking primitive at all — it abstracts over FTP and SSH transports —
	     so there is nothing to port this to. The deletion does use
	     wp_delete_file(). -->
	<rule ref="WordPress.WP.AlternativeFunctions.file_system_operations_fopen">
		<exclude-pattern>/includes/class-polls-vote.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions.file_system_operations_fwrite">
		<exclude-pattern>/includes/class-polls-vote.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions.file_system_operations_fclose">
		<exclude-pattern>/includes/class-polls-vote.php</exclude-pattern>
	</rule>

	<!-- Creating, indexing and dropping the plugin's own three tables is the
	     entire job of the installer and the uninstaller. -->
	<rule ref="WordPress.DB.DirectDatabaseQuery.SchemaChange">
		<exclude-pattern>/includes/class-polls-install.php</exclude-pattern>
		<exclude-pattern>/uninstall.php</exclude-pattern>
	</rule>

	<!-- manage_polls is this plugin's own capability, granted to administrator
	     on activation. The sniff only knows core's list. -->
	<!-- Exception messages from the voting endpoint are escaped once where they
	     are echoed, in Polls_Vote::vote_poll(), rather than at each of the eight
	     throw sites. Escaping at both would double encode. -->
	<rule ref="WordPress.Security.EscapeOutput.ExceptionNotEscaped">
		<exclude-pattern>/includes/class-polls-vote.php</exclude-pattern>
	</rule>

	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_polls"/>
			</property>
		</properties>
	</rule>

	<!-- current_time( 'timestamp' ) is deprecated in favour of time(), but the
	     two are not interchangeable here: poll timestamps have always been
	     stored as site-local time and are rendered back with gmdate(). Swapping
	     in time() would shift every newly created poll by the GMT offset
	     relative to the rows already in the table. Left alone deliberately. -->
	<rule ref="WordPress.DateTime.CurrentTimeTimestamp">
		<severity>0</severity>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array" value="wp-polls"/>
		</properties>
	</rule>

	<!-- Tests assemble their own markup and assert on it. -->
	<rule ref="WordPress.Security.EscapeOutput">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!-- The lock tests open and flock() the lock file directly, which is the only
	     way to simulate a second concurrent voter from one process, and one test
	     reads a source file to prove a removed function is no longer called. -->
	<rule ref="WordPress.WP.AlternativeFunctions.file_system_operations_fopen">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions.file_system_operations_fclose">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions.file_get_contents_file_get_contents">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!-- The class-*.php file naming rule exempts test classes, which follow
	     PHPUnit's own test-*.php convention. -->
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
</ruleset>
